{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 3,
      "right": 3,
    },
  },
  "display": {
    "separator": "",
    "key": {
      "width": 15,
    },
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│           │\u001b[11D\u001b[31m󰟾 os",
      "type": "os",
    },
    {
      "key": "│           │\u001b[11D\u001b[32m kernel",
      "type": "kernel",
    },
    {
      "key": "│           │\u001b[11D\u001b[33m de/wm",
      "type": "wm",
    },
    {
      "key": "│           │\u001b[11D\u001b[34m󰏖 pkgs",
      "type": "packages",
    },
    {
      "key": "│           │\u001b[11D\u001b[35m shell",
      "type": "shell",
    },
    {
      "key": "│           │\u001b[11D\u001b[36m󰅐 uptime",
      "type": "uptime",
    },
    // {
    //   "key": "│           │\u001b[11D\u001b[37m󰻠 cpu",
    //   "type": "cpu",
    //   "freqNdigits": 1,
    // },
    // {
    //   "key": "│           │\u001b[11D\u001b[38m memory",
    //   "type": "memory",
    // },
    // {
    //   "key": "│           │\u001b[11D\u001b[31m󰍛 gpu",
    //   "type": "gpu",
    // },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│           │\u001b[11D\u001b[m󰏘 colors",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
