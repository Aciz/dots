// -*- mode: jsonc -*-
[
    {
        "layer": "top",
    "margin-left": 12,
    "margin-right": 12,
    "margin-top": 12,
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 36, // Waybar height (to be removed for auto height)
    "width": 200, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    
    "modules-center": [
        "clock"
    ],

    "clock": {
        "locale" : "fi_FI.UTF-8",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    }
},
{
    "layer": "bottom",
    "margin-left": 12,
    "margin-right": 12,
    "margin-top": 12,
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 36, // Waybar height (to be removed for auto height)
    "width": 500, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "sway/window" 
    ],
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>",
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "sway/window": {
        "max-length" : 120
    }
}]
